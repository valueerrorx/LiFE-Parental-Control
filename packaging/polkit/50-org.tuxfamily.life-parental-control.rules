// LiFE Parental Control: allow pkexec to run the install script (life-parental-install.sh) as root.
// The script copies daemon files and manages the systemd service.
polkit.addRule(function(action, subject) {
    if (action.id !== 'org.freedesktop.policykit.exec') {
        return polkit.Result.NOT_HANDLED;
    }
    if (subject.local !== true) {
        return polkit.Result.NOT_HANDLED;
    }
    var cmd = action.lookup('command_line');
    if (cmd === null) {
        return polkit.Result.NOT_HANDLED;
    }
    var norm = cmd.toLowerCase();
    // Match the install script by name pattern
    var matches =
        norm.indexOf('life-parental-install') >= 0 ||
        (norm.indexOf('life') >= 0 && norm.indexOf('parental') >= 0 && norm.indexOf('install') >= 0);
    if (!matches) {
        return polkit.Result.NOT_HANDLED;
    }
    return polkit.Result.AUTH_ADMIN;
});
