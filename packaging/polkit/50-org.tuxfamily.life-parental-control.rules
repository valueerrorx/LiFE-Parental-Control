// LiFE Parental Control: allow pkexec to run privileged scripts (install + lockdown) as root.
polkit.addRule(function(action, subject) {
    if (action.id !== 'org.freedesktop.policykit.exec') {
        return polkit.Result.NOT_HANDLED;
    }
    if (subject.local !== true) {
        return polkit.Result.NOT_HANDLED;
    }
    var cmd = action.lookup('command_line');
    if (cmd === null) {
        return polkit.Result.NOT_HANDLED;
    }
    var norm = cmd.toLowerCase();
    // Match install and lockdown scripts by name pattern
    var matches =
        norm.indexOf('life-parental-install') >= 0 ||
        norm.indexOf('life-parental-lockdown') >= 0 ||
        norm.indexOf('life-parental-unlock') >= 0 ||
        (norm.indexOf('life') >= 0 && norm.indexOf('parental') >= 0 &&
            (norm.indexOf('install') >= 0 || norm.indexOf('lockdown') >= 0 || norm.indexOf('unlock') >= 0));
    if (!matches) {
        return polkit.Result.NOT_HANDLED;
    }
    return polkit.Result.AUTH_ADMIN; // admin password required — prevents non-admin users from running these scripts
});
